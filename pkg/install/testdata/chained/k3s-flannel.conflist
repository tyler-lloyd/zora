{
  "name": "cbr0",
  "cniVersion": "1.0.0",
  "plugins": [
    {
      "type": "flannel",
      "delegate": {
        "hairpinMode": true,
        "forceAddress": true,
        "isDefaultGateway": true
      }
    },
    {
      "type": "portmap",
      "capabilities": {
        "portMappings": true
      }
    },
    {
      "type": "bandwidth",
      "capabilities": {
        "bandwidth": true
      }
    },
    {
      "type": "zora",
      "capabilities": {
        "io.kubernetes.cri.pod-annotations": true
      },
      "socket": "/var/run/zora/zora.sock",
      "excludeNamespaces": [
        "kube-system"
      ]
    }
  ]
}
